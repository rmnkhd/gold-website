# ---------------------------------------------------------
# EditorConfig – Unified code style for all IDEs/editors
# ---------------------------------------------------------
root = true

# ---------------------------------------------------------
# Default settings for all files
# ---------------------------------------------------------
[*]
charset = utf-8
end_of_line = lf
insert_final_newline = true
trim_trailing_whitespace = true

indent_style = space
indent_size = 4
tab_width = 4

# ---------------------------------------------------------
# File-type-specific adjustments (Optional)
# ---------------------------------------------------------

# For Markdown (preserve trailing spaces for line breaks)
[*.md]
trim_trailing_whitespace = false

# For JSON (always 2-space indent)
[*.json]
indent_size = 4
